{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnix.local/schemas/finding.schema.json",
  "title": "VULNIX normalized finding",
  "description": "Formato normalizado de hallazgo (manual §6). Todo adaptador debe producir objetos que validen contra este esquema.",
  "type": "object",
  "required": ["fingerprint", "rule_id", "title", "severity", "confidence", "category", "analyzer", "location", "description"],
  "additionalProperties": false,
  "properties": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rule_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "category": { "enum": ["sast", "sca", "secrets", "quality", "dast"] },
    "analyzer": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "cwe": { "type": ["string", "null"], "pattern": "^CWE-[0-9]{1,5}$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": ["string", "null"], "maxLength": 1024 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "remediation": { "type": ["string", "null"], "maxLength": 4000 },
    "verify": { "type": ["string", "null"], "maxLength": 2000 },
    "references": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
    "snippet": { "type": ["string", "null"], "maxLength": 400 },
    "metadata": { "type": "object" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } }
  }
}
