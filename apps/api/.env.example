APP_NAME=VULNIX
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Runtime: rol con permisos mínimos. Migraciones: rol dueño (pgsql_owner).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vulnix
DB_USERNAME=vulnix_api
DB_PASSWORD=
DB_OWNER_USERNAME=vulnix_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
# Poner true cuando se sirva por HTTPS con certificado interno.
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# --- VULNIX ---
VULNIX_ISSUER=vulnix-local
VULNIX_DATA_DIR=
VULNIX_KEYS_DIR=storage/app/keys
VULNIX_INTERNAL_TOKEN=
VULNIX_INTERNAL_ALLOWED_IPS=127.0.0.1,::1
VULNIX_ANALYZER_API_URL=http://127.0.0.1:8100
VULNIX_AUTHORIZATION_TTL_HOURS=168
VULNIX_EXCEPTION_MAX_DAYS=90
VULNIX_MAX_UPLOAD_MB=40
VULNIX_DEFAULT_PROFILE=web-development
VULNIX_DAST_ALLOWED_TARGETS=
